{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#mesa": "./mesa-core/src/index.ts",
    "#mesa/ponte": "./mesa-core/src/ponte.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\" \"mesa-core/tests/*.test.ts\"",
    "assar": "node scripts/assar-colecao.ts",
    "exemplos": "node scripts/exemplos/gerar.ts",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.ts\"",
    "build:core": "tsc -p mesa-core/tsconfig.build.json",
    "mesa-dev": "node scripts/mesa-dev.ts",
    "ponte:mcp": "node scripts/ponte/mcp.ts",
    "dev:mesa": "MESA_DEV_PREFIX=/Atlas/ vite --host 127.0.0.1 --port 5190 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@preact/signals": "2.11.3",
    "pixi.js": "8.22.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "fake-indexeddb": "6.2.6",
    "playwright": "1.58.2",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "ws": "8.22.2"
  }
}
